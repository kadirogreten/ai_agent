# /etc/agentarmy.env — AgentArmy sunucu env dosyası (chmod 600!)
# API, worker ve tüm tick'ler bu dosyayı okur (systemd EnvironmentFile).

# ── Zorunlu ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# ── Araçlar (tedarik otomasyonu) ─────────────────────────────────────────────
SERPER_KEY=
SERPAPI_KEY=
TAVILY_KEY=

# ── Bildirim (PR2) ───────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Modeller (PR10) ─────────────────────────────────────────────────────────
# Anthropic provider'ı llm_providers'ta etkinleştirirsen:
ANTHROPIC_API_KEY=

# ── Yönetim (PR10) ──────────────────────────────────────────────────────────
# Model/araç ayarlarını değiştirebilecek kullanıcı UUID'leri (virgülle):
ADMIN_USER_IDS=

# ── Opsiyonel ───────────────────────────────────────────────────────────────
# CARGO_DEMO_SCALE=60          # dogfood duman testi hızlandırma
# WORKER_INTERVAL_MS=10000     # worker döngü aralığı (servis dosyasında da var)

# ── Sosyal medya / Meta (PR-S7) ─────────────────────────────────────────────
# SOCIAL_TOKEN_ENC_KEY=        # 32 byte base64 — portal + worker aynı anahtar
# META_ACCESS_TOKEN=           # DB OAuth yoksa MCP fallback
# SOCIAL_API_MODE=demo         # Graph çağrısı yok (lokal test)
# META_PAGE_ID=                # Canlı Facebook sayfa yayını
