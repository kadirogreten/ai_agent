{
  "id": "prd-draft",
  "title": "PRD Taslağı (PM persona)",
  "defaultPersona": "urun-yoneticisi",
  "steps": [
    {
      "id": "research",
      "agent": "Researcher",
      "goal": "Problem, kullanıcı, rakip ve pazar sinyallerini topla.",
      "output": "Notlar + kaynakça"
    },
    {
      "id": "analysis",
      "agent": "Analyst",
      "goal": "Varsayımlar, metrikler, riskler ve kapsam/kapsam dışını çıkar.",
      "output": "Tablo: varsayım | doğrulama yolu | risk | metrik"
    },
    {
      "id": "write",
      "agent": "Writer",
      "goal": "PRD taslağını üret.",
      "output": "Markdown: Problem, Hedefler, Kapsam, Kullanıcı Hikayeleri, Metrikler, Riskler, Açık Sorular"
    },
    {
      "id": "verify",
      "agent": "Verifier",
      "goal": "Ölçülebilirlik ve tutarlılık kontrolü yap.",
      "output": "Denetim raporu: PASS/FAIL + düzeltmeler"
    },
    {
      "id": "edit",
      "agent": "Editor",
      "goal": "Okunabilirlik ve formatı finalle.",
      "output": "Final PRD"
    }
  ]
}

