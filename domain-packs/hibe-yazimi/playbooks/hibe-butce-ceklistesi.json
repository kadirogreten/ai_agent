{
  "version": 1,
  "id": "hibe-butce-ceklistesi",
  "title": "Bütçe kalemleri — çekliste ve uyum notları",
  "defaultPersona": "butce-analisti",
  "defaultRisk": "R1",
  "steps": [
    {
      "id": "lines",
      "agent": "Analyst",
      "goal": "Kalem listesi taslağı: personel, ekipman, seyahat, alt yüklenici vb.; her kalem uygun/unvan notu ile.",
      "output": "Markdown tablo kalem | gerekçe | risk"
    },
    {
      "id": "explain",
      "agent": "Writer",
      "goal": "Kısaltılmış bütçe gerekçe metni; varsayımsal rakamları etiketle.",
      "output": "Açıklama paragrafları"
    },
    {
      "id": "verify",
      "agent": "Verifier",
      "goal": "`rubrics/verifier.md` sayısal iddia ve doğrulanabilirlik.",
      "output": "Denetim + PASS/FAIL"
    },
    {
      "id": "edit",
      "agent": "Editor",
      "goal": "Tablo/format tutarlılığı.",
      "output": "Final"
    }
  ]
}
