{
  "version": 1,
  "id": "akademik-ortak-eslestir",
  "title": "Akademik ortak eşleştirme (öneri tablosu)",
  "defaultPersona": "arge-yoneticisi",
  "defaultRisk": "R1",
  "steps": [
    {
      "id": "discover",
      "agent": "Researcher",
      "goal": "Konu uyumlu gruplar ve projeler için OpenAlex/arşiv bağlantılarını ara.",
      "output": "Aday liste + URL"
    },
    {
      "id": "match",
      "agent": "Analyst",
      "goal": "Her aday için olgunluk, tamamlayıcılık, risk tablosu; çıkar çatışması notu.",
      "output": "Karşılaştırma tablosu"
    },
    {
      "id": "recommend",
      "agent": "Writer",
      "goal": "1–3 öncelikli ortak ve iletişim gerekçesi (spekülasyon etiketi).",
      "output": "Öneri özeti"
    },
    {
      "id": "verify",
      "agent": "Verifier",
      "goal": "Uydurma laboratuvar/kişi yok mu.",
      "output": "PASS/FAIL + notlar"
    },
    {
      "id": "edit",
      "agent": "Editor",
      "goal": "Kısalt ve netleştir.",
      "output": "Final"
    }
  ]
}
